amends "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/helpers.pkl"

subprojects = List("docs")

local picked =
  helpers.pick(new Listing {
    "rust"
    "github-actions"
    "oxfmt"
    "tombi"
    "yaml"
    "typos"
    "hygiene"
  })

steps = (picked) {
  ["hygiene"] = (picked["hygiene"] as Group) {
    steps = ((picked["hygiene"] as Group).steps) {
      ["newlines"] = ((picked["hygiene"] as Group).steps["newlines"]) {
        // release-plz generates CHANGELOG.md without a trailing newline.
        exclude = List("CHANGELOG.md")
      }
      ["check-shebang-scripts-are-executable"] = ((picked["hygiene"] as Group).steps["check-shebang-scripts-are-executable"]) {
        // Rust inner attributes (#![...]) are misidentified as shebangs.
        exclude = List("**/*.rs")
      }
    }
  }
  ["oxfmt"] = (picked["oxfmt"]) {
    // Duplicate .oxfmtrc.json ignorePatterns so hk skips this step when only
    // ignored paths change; oxfmt ignore alone still runs the step and exits 0.
    // mise verifies generated dependency sidecars by their exact byte digest.
    exclude = List("CHANGELOG.md", "docs/src/cli/**", "schema/**", "**/*.toml", ".mise/locks/**")
  }
  ["yaml"] = (picked["yaml"] as Group) {
    steps = ((picked["yaml"] as Group).steps) {
      ["yamllint"] = ((picked["yaml"] as Group).steps["yamllint"]) {
        exclude = List("**/aube-lock.yaml")
      }
      ["yamlfmt"] = ((picked["yaml"] as Group).steps["yamlfmt"]) {
        exclude = List("**/aube-lock.yaml")
      }
    }
  }
  ["typos"] = (picked["typos"]) {
    // Ignore autogenerated files.
    exclude = List(".gitignore", "biwa.usage.kdl", "CHANGELOG.md", "docs/src/cli/**")
  }
}
