#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${BIWA_TEST_SSH_PORT:-}" ]] \
	|| [[ -z "${BIWA_TEST_SSH_CAPABLE_PORT:-}" ]]; then
	status=$(pitchfork status ssh-server --json)
	if [[ "$(yq --input-format json '.port | length' <<<"${status}")" != "2" ]]; then
		echo "Expected Pitchfork to resolve two SSH test ports." >&2
		exit 1
	fi
	resolved_ssh_port=$(
		yq --input-format json --output-format tsv '.port[0]' <<<"${status}"
	)
	resolved_ssh_capable_port=$(
		yq --input-format json --output-format tsv '.port[1]' <<<"${status}"
	)
	export BIWA_TEST_SSH_PORT="${BIWA_TEST_SSH_PORT:-${resolved_ssh_port}}"
	export BIWA_TEST_SSH_CAPABLE_PORT="${BIWA_TEST_SSH_CAPABLE_PORT:-${resolved_ssh_capable_port}}"
fi

exec "$@"
