#!/usr/bin/env bash

set -euo pipefail

export BIWA_TEST_SSH_PORT="${PORT0:-2222}"
export BIWA_TEST_SSH_CAPABLE_PORT="${PORT1:-2223}"

compose_pid=

cleanup() {
	trap - EXIT INT TERM
	if [[ -n "${compose_pid}" ]]; then
		kill "${compose_pid}" 2>/dev/null || true
		wait "${compose_pid}" 2>/dev/null || true
	fi
	docker compose down --remove-orphans
}
trap cleanup EXIT INT TERM

docker compose up --build &
compose_pid=$!

until nc -z localhost "${BIWA_TEST_SSH_PORT}" \
	&& nc -z localhost "${BIWA_TEST_SSH_CAPABLE_PORT}"; do
	if ! kill -0 "${compose_pid}" 2>/dev/null; then
		wait "${compose_pid}"
	fi
	sleep 0.2
done

echo "SSH test servers are ready"
wait "${compose_pid}"
